import { useEffect, useMemo, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { useStore } from '../store/useStore'
import Skeleton from '../components/ui/Skeleton'

// DaddyLive public embed API: GET /api/channels returns
// { channels: [{ channel_name, url }] } with CORS enabled — the client can
// fetch it directly and each channel url is an iframe-embeddable player page.
const CHANNELS_API = 'https://daddylive.mov/api/channels'

// Rough genre buckets derived from channel names (the API has no categories).
const BUCKETS = [
  ['Sports', ['sport', 'sky sports', 'bt sport', 'espn', 'bein', 'dazn', 'fox sport', 'nba', 'nfl', 'ufc', 'wwe', 'premier', 'football', 'soccer', 'cricket', 'tennis', 'golf', 'motorsport', 'f1', 'wwe']],
  ['News', ['news', 'bbc news', 'cnn', 'sky news', 'al jazeera', 'msnbc', 'fox news', 'cnbc', 'bloomberg']],
  ['Kids', ['kids', 'cartoon', 'nick', 'disney', 'baby', 'boomerang', 'nickelodeon']],
  ['Movies & Series', ['movie', 'cinema', 'series', 'action', 'thriller', 'hbo', 'paramount']],
  ['Documentary', ['documentary', 'discovery', 'nat geo', 'national geographic', 'history', 'animal', 'nature']],
  ['Entertainment', ['entertainment', 'comedy', 'lifestyle', 'reality', 'uk:', 'us:']],
  ['Music', ['music', 'mtv', 'vh1']],
]

function bucketFor(name) {
  const n = name.toLowerCase()
  for (const [label, keys] of BUCKETS) {
    if (keys.some((k) => n.includes(k))) return label
  }
  return 'Other Channels'
}

export default function LiveTV() {
  const navigate = useNavigate()
  const liveTvEnabled = useStore((s) => s.liveTvEnabled)

  const [channels, setChannels] = useState(null)
  const [error, setError] = useState(null)
  const [filter, setFilter] = useState('')
  const [category, setCategory] = useState('All')

  useEffect(() => {
    let cancelled = false
    ;(async () => {
      try {
        const res = await fetch(CHANNELS_API)
        if (!res.ok) throw new Error('HTTP ' + res.status)
        const data = await res.json()
        if (!cancelled) {
          setChannels((data.channels || []).filter((c) => c.channel_name && c.url))
        }
      } catch {
        if (!cancelled) setError('Could not load the channel list. Please try again.')
      }
    })()
    return () => { cancelled = true }
  }, [])

  const categories = useMemo(() => {
    if (!channels) return []
    const counts = new Map()
    for (const c of channels) {
      const b = bucketFor(c.channel_name)
      counts.set(b, (counts.get(b) || 0) + 1)
    }
    return [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => ({ name, count }))
  }, [channels])

  const filtered = useMemo(() => {
    if (!channels) return []
    const q = filter.toLowerCase().trim()
    return channels.filter((c) => {
      if (category !== 'All' && bucketFor(c.channel_name) !== category) return false
      return q ? c.channel_name.toLowerCase().includes(q) : true
    })
  }, [channels, filter, category])

  const openChannel = (ch) => {
    navigate(`/player/live?dl=${encodeURIComponent(ch.url)}&name=${encodeURIComponent(ch.channel_name)}`)
  }

  if (!liveTvEnabled) {
    return (
      <main className="pt-24 md:pt-32 px-container-padding-mobile md:px-container-padding-desktop pb-32">
        <div className="max-w-2xl mx-auto text-center py-20 md:py-32">
          <span className="material-symbols-outlined text-[56px] text-primary" style={{ fontVariationSettings: "'FILL' 1" }}>live_tv</span>
          <h1 className="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-background mt-6">Live TV is currently off</h1>
          <p className="font-body-lg text-body-lg text-on-surface-variant mt-4 leading-relaxed">
            Live channels are temporarily unavailable. Please check back soon.
          </p>
        </div>
      </main>
    )
  }

  return (
    <main className="relative min-h-screen pt-24 md:pt-32 px-container-padding-mobile md:px-container-padding-desktop pb-32">
      <div className="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
          <h1 className="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-2">Live TV</h1>
          <p className="font-body-lg text-body-lg text-tertiary flex items-center gap-3">
            <span className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/15 border border-primary/30 font-label-sm text-label-sm text-primary uppercase tracking-wider">
              <span className="w-2 h-2 rounded-full bg-primary animate-pulse"></span> Live
            </span>
            {channels ? `${channels.length} channels` : 'Loading channels…'}
          </p>
        </div>
        <div className="relative w-full max-w-md">
          <span className="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">search</span>
          <input
            value={filter}
            onChange={(e) => setFilter(e.target.value)}
            placeholder="Filter channels…"
            className="w-full bg-surface-container/50 border border-white/10 rounded-full py-3 pl-12 pr-4 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-secondary glass-panel"
          />
        </div>
      </div>

      {error && (
        <div className="text-center py-20">
          <span className="material-symbols-outlined text-[44px] text-on-surface-variant">wifi_off</span>
          <p className="text-on-surface-variant font-body-md text-body-md mt-4 mb-6">{error}</p>
          <button onClick={() => window.location.reload()} className="px-6 py-2.5 rounded-full font-label-md text-white btn-primary">Retry</button>
        </div>
      )}

      {!error && !channels && (
        <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-gutter">
          {Array.from({ length: 12 }, (_, i) => <Skeleton key={i} className="aspect-video" />)}
        </div>
      )}

      {channels && categories.length > 1 && (
        <div className="flex items-center gap-2.5 overflow-x-auto no-scrollbar pb-2 mb-8" id="live-category-chips">
          {['All', ...categories.map((c) => c.name)].map((name) => {
            const active = name === category
            const count = name === 'All' ? channels.length : categories.find((c) => c.name === name)?.count || 0
            return (
              <button
                key={name}
                onClick={() => setCategory(name)}
                className={
                  'px-4 py-1.5 rounded-full border font-label-md text-label-md whitespace-nowrap transition-colors ' +
                  (active
                    ? 'border-primary/60 bg-primary/10 text-primary'
                    : 'border-white/10 bg-surface-container-high/50 text-on-surface-variant hover:text-on-surface hover:border-white/25')
                }
              >
                {name} <span className="opacity-60">{count}</span>
              </button>
            )
          })}
        </div>
      )}

      {filtered.length > 0 && (
        <div id="live-grid" className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-gutter">
          {filtered.map((ch) => (
            <button
              key={ch.url}
              onClick={() => openChannel(ch)}
              className="group relative aspect-video rounded-lg overflow-hidden bg-surface-container-low ring-1 ring-white/5 cursor-pointer transition-all duration-300 hover:ring-white/20 hover:shadow-[0_12px_32px_rgba(0,0,0,0.6)] text-left"
            >
              <div className="absolute inset-0 flex items-center justify-center bg-surface-container-high">
                <span className="font-headline-md text-headline-md text-on-surface-variant/70 tracking-wider">
                  {ch.channel_name.split(/\s+/).slice(0, 2).map((w) => w[0] || '').join('').toUpperCase()}
                </span>
              </div>
              <div className="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity"></div>
              <div className="absolute inset-x-0 bottom-0 p-3">
                <p className="font-label-md text-label-md text-on-surface truncate">{ch.channel_name}</p>
              </div>
              <span className="absolute top-2 right-2 w-9 h-9 rounded-full btn-primary text-white flex items-center justify-center opacity-0 scale-75 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300">
                <span className="material-symbols-outlined text-[18px]" style={{ fontVariationSettings: "'FILL' 1" }}>play_arrow</span>
              </span>
            </button>
          ))}
        </div>
      )}

      {channels && filtered.length === 0 && (
        <p className="text-center text-on-surface-variant py-16">No channels match "{filter}"</p>
      )}
    </main>
  )
}
